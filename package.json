{
  "name": "@virtin37/dsh-prompt-library",
  "version": "0.1.0",
  "description": "DeepSeek Harness 右侧栏的提示词库：分组、搜索、填空后插入输入框，不自动发送。",
  "license": "MIT",
  "author": "virtin37",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtin37/dsh-prompt-library.git"
  },
  "bugs": {
    "url": "https://github.com/virtin37/dsh-prompt-library/issues"
  },
  "homepage": "https://github.com/virtin37/dsh-prompt-library#readme",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "prompt-library",
    "prompts",
    "templates"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/slots.test.mjs"
  },
  "engines": {
    "dsh": "^0.2.3-alpha.2",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
